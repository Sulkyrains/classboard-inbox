/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' https://tessdata.projectnaptha.com; worker-src 'self' blob:; manifest-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/
  Cache-Control: no-store
/index.html
  Cache-Control: no-store
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
/manifest.webmanifest
  Cache-Control: no-cache
/offline.html
  Cache-Control: no-cache
/classboard.apk
  Cache-Control: no-cache
/app-version.json
  Cache-Control: no-cache
